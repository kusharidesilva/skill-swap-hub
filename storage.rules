rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function authorizedAdminEmail() {
      return 'kusharidesilva3@gmail.com';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAuthorizedAdminEmail() {
      return isAuthenticated() &&
        request.auth.token.email == authorizedAdminEmail();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /profile-images/{userId}/{allPaths=**} {
      // Profile images stay inside a folder named with the owner's UID.
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/png',
          'image/jpeg',
          'image/webp'
        ];
    }

    match /reports/{userId}/{allPaths=**} {
      // Evidence is private to the reporter at the storage layer.
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) &&
        request.resource.size <= 1 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/png',
          'image/jpeg',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
    }

    match /student-proofs/{userId}/{allPaths=**} {
      // Student proof is uploaded by the owner and reviewed by the authorized admin.
      allow read: if isOwner(userId) || isAdmin() || isAuthorizedAdminEmail();
      allow write: if isOwner(userId) &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/png',
          'image/jpeg'
        ];
    }

    match /gig-samples/{userId}/{allPaths=**} {
      // Providers upload sample work images for their own service gigs.
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/png',
          'image/jpeg',
          'image/webp'
        ];
    }

    match /chat-attachments/{chatId}/{allPaths=**} {
      // Chat attachments include payment slips, images, PDFs, and small documents.
      allow read: if isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/chats/$(chatId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
      allow write: if isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/chats/$(chatId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/png',
          'image/jpeg',
          'image/webp',
          'application/pdf',
          'text/plain',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
    }

    // Keep the bucket locked down by default. Add explicit matches for any
    // new upload locations instead of opening the whole bucket.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
