    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5"
