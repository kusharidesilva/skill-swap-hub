rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authorizedAdminEmail() {
      return 'kusharidesilva3@gmail.com';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function signedInProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile() &&
        signedInProfile().data.role == 'admin';
    }

    function hasActiveAccount() {
      return hasProfile() && signedInProfile().data.accountStatus != 'suspended';
    }

    function isVerifiedProvider() {
      return hasActiveAccount() &&
        signedInProfile().data.providerVerificationStatus == 'approved' &&
        signedInProfile().data.canSellServices == true;
    }

    function canSelfConfirmEmail(userId) {
      return isOwner(userId) &&
        resource.data.accountStatus == 'pending_email_verification' &&
        request.auth.token.email_verified == true &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.emailVerified == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accountStatus',
          'emailVerified',
          'canBuyServices',
          'updatedAt'
        ]);
    }

    function canSelfResubmitVerificationUser(userId) {
      return isOwner(userId) &&
        resource.data.providerVerificationStatus == 'rejected' &&
        request.resource.data.role == 'provider' &&
        request.resource.data.accountStatus in [
          'pending_admin_verification',
          'pending_verification'
        ] &&
        request.resource.data.providerVerificationStatus == 'pending' &&
        request.resource.data.canBuyServices == false &&
        request.resource.data.canSellServices == false &&
        request.resource.data.verifiedStudentProvider == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'accountStatus',
          'providerVerificationStatus',
          'canBuyServices',
          'canSellServices',
          'verifiedStudentProvider',
          'studentProof',
          'resubmissionMessage',
          'updatedAt'
        ]);
    }

    function canSelfResubmitProviderVerification() {
      return isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'rejected' &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'proof',
          'studentMessage',
          'resubmissionMessage',
          'resubmittedAt',
          'submittedAt',
          'updatedAt'
        ]);
    }

    function isReportTarget() {
      return isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.reportedUserId == request.auth.uid ||
        resource.data.reportedUser == request.auth.uid
      );
    }

    function canReportedUserReplyToReport() {
      return hasActiveAccount() &&
        isReportTarget() &&
        (
          request.resource.data.status == resource.data.status ||
          (
            resource.data.status == 'Warn' &&
            request.resource.data.status == 'Pending'
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reportedUserResponses',
          'status',
          'adminNeedsReview',
          'lastResponseAt',
          'updatedAt'
        ]);
    }

    function protectedUserFields() {
      return [
        'role',
        'accountStatus',
        'providerVerificationStatus',
        'canSellServices',
        'verifiedStudentProvider',
        'studentProof',
        'adminNote',
        'providerApprovedAt',
        'emailVerified'
      ];
    }

    function canSelfBecomeBuyer(userId) {
      return isOwner(userId) &&
        resource.data.role == 'provider' &&
        resource.data.providerVerificationStatus == 'approved' &&
        request.resource.data.role == 'both' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
    }

    function canBootstrapAuthorizedAdmin(userId) {
      return isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == authorizedAdminEmail() &&
        request.resource.data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if hasActiveAccount() || isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        (
          (
            request.resource.data.role == 'buyer' &&
            request.resource.data.canSellServices == false
          ) ||
          (
            request.resource.data.role == 'provider' &&
            request.resource.data.accountType == 'student' &&
            request.resource.data.providerVerificationStatus == 'pending' &&
            request.resource.data.canSellServices == false &&
            request.resource.data.accountStatus in [
              'pending_admin_verification',
              'pending_verification'
            ]
          ) ||
          canBootstrapAuthorizedAdmin(userId)
        );
      allow update: if isAdmin() || canBootstrapAuthorizedAdmin(userId) || canSelfBecomeBuyer(userId) || canSelfConfirmEmail(userId) || canSelfResubmitVerificationUser(userId) || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields())
      );
      allow delete: if false;
    }

    match /providerProfiles/{providerId} {
      allow read: if hasActiveAccount();
      allow create, update: if isAdmin() || (
        isVerifiedProvider() &&
        request.auth.uid == providerId
      );
      allow delete: if false;
    }

    match /providerServiceCategories/{itemId} {
      allow read: if hasActiveAccount();
      allow create, update: if isAdmin() || (
        isVerifiedProvider() &&
        request.resource.data.providerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /providerAvailability/{availabilityId} {
      allow read: if hasActiveAccount();
      allow create, update: if isAdmin() || (
        isVerifiedProvider() &&
        request.resource.data.providerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /providerVerifications/{verificationId} {
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.status == 'pending';
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update: if isAdmin() || canSelfResubmitProviderVerification();
      allow delete: if false;
    }

    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /universities/{universityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /issueTypes/{issueTypeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /availabilityTimeSlots/{timeSlotId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /availabilityDays/{dayId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gigs/{gigId} {
      allow read: if (
        resource.data.status == 'active' ||
        resource.data.gigStatus == 'active'
      ) && resource.data.status != 'removed';
      allow create: if isVerifiedProvider() &&
        request.resource.data.providerId == request.auth.uid;
      allow update: if isAdmin() || (
        isVerifiedProvider() &&
        resource.data.providerId == request.auth.uid &&
        request.resource.data.providerId == resource.data.providerId
      );
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if hasActiveAccount() && (
        isAdmin() ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        resource.data.providerId == 'general' ||
        resource.data.status == 'completed'
      );
      allow create: if hasActiveAccount() &&
        request.resource.data.buyerId == request.auth.uid;
      allow update: if hasActiveAccount() && (
        isAdmin() ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        resource.data.providerId == 'general'
      );
      allow delete: if isAdmin() || (
        hasActiveAccount() && resource.data.buyerId == request.auth.uid
      );
    }

    match /providerGeneralRequests/{responseId} {
      allow read: if hasActiveAccount();
      allow create: if isVerifiedProvider() &&
        request.resource.data.providerId == request.auth.uid;
      allow update: if isAdmin() || (
        hasActiveAccount() &&
        resource.data.providerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /directServiceRequests/{requestId} {
      allow read: if hasActiveAccount() && (
        isAdmin() ||
        resource.data.buyerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow create: if hasActiveAccount() &&
        request.resource.data.buyerUserId == request.auth.uid &&
        request.resource.data.providerId != request.auth.uid;
      allow update: if hasActiveAccount() && (
        isAdmin() ||
        resource.data.buyerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /serviceOrders/{orderId} {
      allow read: if hasActiveAccount() && (
        isAdmin() ||
        resource.data.buyerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow create: if hasActiveAccount() &&
        request.resource.data.buyerUserId == request.auth.uid &&
        request.resource.data.providerId != request.auth.uid;
      allow update: if hasActiveAccount() && (
        isAdmin() ||
        resource.data.buyerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if hasActiveAccount() && (
        isAdmin() || request.auth.uid in resource.data.participants
      );
      allow create: if hasActiveAccount() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if hasActiveAccount() && (
        isAdmin() || request.auth.uid in resource.data.participants
      );
      allow delete: if false;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if hasActiveAccount() && (
        isAdmin() ||
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
      );
      allow create: if hasActiveAccount() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
        request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if hasActiveAccount() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if hasActiveAccount() || isAdmin();
      allow update, delete: if hasActiveAccount() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
    }

    match /reports/{reportId} {
      allow create: if hasActiveAccount() &&
        request.resource.data.reporterId == request.auth.uid;
      allow read: if hasActiveAccount() && (
        isAdmin() ||
        resource.data.reporterId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        resource.data.reportedUserId == request.auth.uid ||
        resource.data.reportedUser == request.auth.uid
      );
      allow update: if isAdmin() || canReportedUserReplyToReport();
      allow delete: if false;
    }

    match /reportEvidence/{evidenceId} {
      allow read: if hasActiveAccount();
      allow create: if hasActiveAccount() &&
        request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if hasActiveAccount();
      allow create: if hasActiveAccount() &&
        request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /ratingReviews/{reviewId} {
      allow read: if hasActiveAccount();
      allow create: if hasActiveAccount() &&
        request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if false;
    }

    match /adminActions/{actionId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }
  }
}
